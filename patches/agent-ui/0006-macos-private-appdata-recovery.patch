diff --git a/toolkit/xre/nsXREDirProvider.cpp b/toolkit/xre/nsXREDirProvider.cpp
--- a/toolkit/xre/nsXREDirProvider.cpp
+++ b/toolkit/xre/nsXREDirProvider.cpp
@@ -77,6 +77,7 @@
 #  include "WinUtils.h"
 #endif
 #ifdef XP_MACOSX
+#  include "FrxMacAppData.h"
 #  ifdef NIGHTLY_BUILD
 #    include "AppGroupPath.h"
 #  endif
@@ -1257,6 +1258,30 @@ nsresult nsXREDirProvider::GetUserDataDirectory(nsIFile** aFile, bool aLocal) {
     NS_ENSURE_SUCCESS(rv, rv);
   }
 
+#ifdef XP_MACOSX
+  // Keep explicit roots and custom application namespaces under caller control.
+  if (gAppData && gAppData->name && !gAppData->profile &&
+      nsDependentCString(gAppData->name).EqualsLiteral("Firefox")) {
+    if (!aLocal && !mozilla::EnvHasValue("MOZ_APP_DATA")) {
+      MOZ_TRY(mozilla::frx::ResolveMacAppData(localDir, localDir));
+    } else if (aLocal && !mozilla::EnvHasValue("MOZ_LOCAL_APP_DATA")) {
+      // Resolve the non-local root first even when the cache is requested first.
+      nsCOMPtr<nsIFile> global;
+      MOZ_TRY(GetUserDataDirectory(getter_AddRefs(global), false));
+      nsCOMPtr<nsIFile> alternate;
+      MOZ_TRY(GetUserDataDirectoryHome(getter_AddRefs(alternate), false));
+      MOZ_TRY(alternate->AppendNative("FirefoxReverse"_ns));
+      bool independent = false;
+      MOZ_TRY(global->Equals(alternate, &independent));
+      if (independent) {
+        MOZ_TRY(GetUserDataDirectoryHome(getter_AddRefs(localDir), true));
+        MOZ_TRY(localDir->AppendNative("FirefoxReverse"_ns));
+        MOZ_TRY(mozilla::frx::CreateAppDataDirectory(localDir));
+      }
+    }
+  }
+#endif
+
   rv = EnsureDirectoryExists(localDir);
   NS_ENSURE_SUCCESS(rv, rv);
 
