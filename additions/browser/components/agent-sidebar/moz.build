# 注册到 resource:///modules/agentsidebar/<name>.sys.mjs
EXTRA_JS_MODULES.agentsidebar += [
    "modules/AddonBackend.sys.mjs",
    "modules/AgentEvalChild.sys.mjs",
    "modules/AgentInteractionChild.sys.mjs",
    "modules/AgentLoop.sys.mjs",
    "modules/AgentSession.sys.mjs",
    "modules/Backends.sys.mjs",
    "modules/CodeBackend.sys.mjs",
    "modules/ConfigStore.sys.mjs",
    "modules/ContextProjection.sys.mjs",
    "modules/ConversationStore.sys.mjs",
    "modules/EnvironmentBackend.sys.mjs",
    "modules/EnvironmentCommon.sys.mjs",
    "modules/EnvironmentControl.sys.mjs",
    "modules/EnvironmentCurrentProcess.sys.mjs",
    "modules/EnvironmentFingerprint.sys.mjs",
    "modules/EnvironmentPrefs.sys.mjs",
    "modules/EnvironmentProcess.sys.mjs",
    "modules/EnvironmentStore.sys.mjs",
    "modules/JsvmpBackend.sys.mjs",
    "modules/LedgerBackend.sys.mjs",
    "modules/LlmClient.sys.mjs",
    "modules/NativeFingerprintPolicy.sys.mjs",
    "modules/NetworkBackend.sys.mjs",
    "modules/NotesBackend.sys.mjs",
    "modules/PageAccessibility.sys.mjs",
    "modules/PageBackend.sys.mjs",
    "modules/PageInteractionBackend.sys.mjs",
    "modules/PageInteractionCore.sys.mjs",
    "modules/providers.sys.mjs",
    "modules/ReasoningEffort.sys.mjs",
    "modules/ScriptsBackend.sys.mjs",
    "modules/SidebarTypography.sys.mjs",
    "modules/SkillBackend.sys.mjs",
    "modules/ToolRouter.sys.mjs",
    "modules/Tools.sys.mjs",
    "modules/Usage.sys.mjs",
    "modules/WebApiBackend.sys.mjs",
    "modules/WorkspaceBackend.sys.mjs",
]

# 启动分类：环境浏览器里的退出通道（EnvironmentControl）
EXTRA_COMPONENTS += [
    "agent-sidebar.manifest",
]

DIRS += ["preferences"]

JAR_MANIFESTS += ["jar.mn"]

with Files("**"):
    BUG_COMPONENT = ("Firefox", "Sidebar")
