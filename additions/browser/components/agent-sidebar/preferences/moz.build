# Agent sidebar modules are installed below dist/bin/browser, but default
# preferences must live at the application root to be packaged and loaded.
DIST_SUBDIR = ""
FINAL_TARGET = "dist/bin"

FINAL_TARGET_FILES.defaults.pref += [
    "frx-locale.js",
]
